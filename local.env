# <---------- Airflow ---------->

AIRFLOW_IMAGE_NAME=apache/airflow:latest
AIRFLOW__CORE__FERNET_KEY='lmnHJcz5u4D8SPEeD4qwAf1TUk_yLXXnQfwlvQ8MXsU='
AIRFLOW_HOME=/opt/airflow/
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_UID=50000


# <---------- Postgres Airflow ---------->

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=postgres_dw
POSTGRES_PASSWORD_DW=postgres_dw
POSTGRES_DB_DW=data_warehouse


# <---------- MinIO ---------->
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=data-lake

# <---------- Storage ---------->
# Options: minio | s3 | adls
STORAGE_BACKEND=minio
# Set to true to also write raw data to Postgres during ingestion
ENABLE_POSTGRES_INGEST=false

# <---------- Superset (perfil `bi` do compose, ADR-0019) ---------->
SUPERSET_SECRET_KEY=govhub-superset-local-dev
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# Conexão que as dashboards importadas usam para ler o warehouse. A senha vai
# mascarada de propósito: o import do Superset a recebe por fora, em
# SUPERSET_DW_PASSWORD, e é assim também em homologação e produção.
#
# O usuário é o mesmo que o dbt usa para materializar (profiles.yml, DBT_USER):
# a dashboard tem que ler com um papel que enxergue o que o dbt escreveu.
# POSTGRES_USER_DW/POSTGRES_PASSWORD_DW abaixo descrevem um papel que o
# docker/postgres/init.sh não chega a criar — não use como conexão do Superset
# sem criá-lo antes.
SUPERSET_DW_URI=postgresql+psycopg2://postgres:XXXXXXXXXX@postgres:5432/data_warehouse
SUPERSET_DW_PASSWORD=postgres
